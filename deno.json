{
  "name": "@dusk/exu",
  "version": "0.2.0",
  "exports": "./src/mod.js",
  "imports": {
    "test-harness": "http://rawcdn.githack.com/mio-mini/test-harness/0.1.0/mod.js"
  },
  "tasks": {
    "test": "deno test --allow-net --allow-read --allow-import",
    "coverage": "deno test --coverage=coverage --coverage-raw-data-only --clean --allow-net --allow-read --allow-import && deno coverage --include=src/ coverage"
  },
  "publish": {
    "include": ["LICENSE", "README.md", "src"],
    "exclude": ["src/tests"]
  }
}
